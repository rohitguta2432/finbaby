default_platform(:android)

AAB_PATH = "app/build/outputs/bundle/release/app-release.aab"

platform :android do
  desc "Assemble a signed release AAB"
  lane :build do
    gradle(task: "clean")
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "."
    )
  end

  desc "Upload AAB to the internal testing track"
  # NB: release_status MUST be "completed" (not "draft") here. The
  # promote_to_production lane promotes the latest *completed* release from the
  # internal track — if internal uploads land as "draft", promote silently
  # picks the previous completed versionCode instead, shipping a stale build.
  # That bit us 2026-06-01: run #6 uploaded vc6 as draft, promote shipped the
  # OLD vc2 (with the wrong launcher icon) → Misleading Claims rejection.
  # "completed" also means internal testers get every CI build automatically,
  # which is what an internal track is for.
  lane :internal do
    build
    upload_to_play_store(
      track: "internal",
      aab: AAB_PATH,
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote the latest internal build to production with staged rollout"
  # NB: For a brand-new app that's never been reviewed by Google ("draft app"
  # in Play Console terms), the Play API rejects all of:
  #   - rollout < 1.0          → "Staged rollout is not permitted on draft app"
  #   - release_status != draft → "Only releases with status draft may be
  #                                created on draft app"
  # And Fastlane's supply also enforces (client-side):
  #   - rollout + release_status=draft → "Cannot specify rollout percentage
  #                                       when the track promote release status
  #                                       is set to 'draft'"
  # So:
  #   - default release_status is "draft" → safe for first release. The user
  #     clicks "Send for review" in Play Console once.
  #   - rollout is ONLY passed when release_status is NOT "draft".
  # After Google approves the first Production release, you can override:
  #   FINBABY_RELEASE_STATUS=completed FINBABY_ROLLOUT=0.1
  # for normal staged rollouts on subsequent releases.
  lane :promote_to_production do |options|
    rollout = (options[:rollout] || ENV["FINBABY_ROLLOUT"] || "0.1").to_s
    release_status = (options[:release_status] || ENV["FINBABY_RELEASE_STATUS"] || "draft").to_s
    params = {
      track: "internal",
      track_promote_to: "production",
      track_promote_release_status: release_status,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    }
    # rollout is only valid when the promoted release is "completed" / live —
    # for draft promotions we omit it entirely.
    params[:rollout] = rollout unless release_status == "draft"
    upload_to_play_store(**params)
  end

  desc "Full release: build, upload to internal, promote to production"
  lane :release do |options|
    internal
    promote_to_production(rollout: options[:rollout])
  end
end
