# Local-only signing config for release builds.
# Copy this file to `keystore.properties` (which is gitignored) and fill in real values.
# CI builds populate these via env vars (FINBABY_*) instead — see .github/workflows/release.yml.

storeFile=/absolute/path/to/finbaby-release.jks
storePassword=replace-me
keyAlias=finbaby
keyPassword=replace-me
