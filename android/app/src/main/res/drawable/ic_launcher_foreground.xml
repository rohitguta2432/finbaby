<?xml version="1.0" encoding="utf-8"?>
<!--
  Jama ledger-bars + sparkle. Matches store-assets/icon-512.png exactly (same
  3-bars-fanning-downward + amber sparkle design). Adaptive-icon background is
  #0D9488 (see values/colors.xml); these bars float on top, inset to the
  center safe zone so launcher masks (circle/squircle) don't clip them.
  Do NOT change one icon without the other — an installed-icon vs store-icon
  mismatch is a Google Play "Misleading Claims" rejection (learned 2026-06-01).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top bar (white) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40.5,40 L67.5,40 A4.5,4.5 0 0 1 67.5,49 L40.5,49 A4.5,4.5 0 0 1 40.5,40 Z" />

    <!-- Middle bar (teal mid) -->
    <path
        android:fillColor="#14B8A6"
        android:pathData="M37.5,52 L70.5,52 A4.5,4.5 0 0 1 70.5,61 L37.5,61 A4.5,4.5 0 0 1 37.5,52 Z" />

    <!-- Bottom bar (teal lite) -->
    <path
        android:fillColor="#2DD4BF"
        android:pathData="M34.5,64 L73.5,64 A4.5,4.5 0 0 1 73.5,73 L34.5,73 A4.5,4.5 0 0 1 34.5,64 Z" />

    <!-- Amber sparkle, upper-right -->
    <path
        android:fillColor="#FBBF24"
        android:pathData="M72,31 L74.5,35.5 L79,38 L74.5,40.5 L72,45 L69.5,40.5 L65,38 L69.5,35.5 Z" />

</vector>
